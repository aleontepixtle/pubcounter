# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development  # Change to 'production' on your server
SECRET_KEY=your-secret-key-here-change-this-to-something-random-and-long
DEBUG=True  # Set to False in production

# Database
DATABASE_URL=sqlite:///app.db  # Or postgresql://user:pass@localhost/dbname

# Redis Configuration (for job queue)
REDIS_URL=redis://localhost:6379/0

# Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Session Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600  # 1 hour in seconds

# Registration Settings
REQUIRE_ADMIN_APPROVAL=True  # New users need admin approval
ADMIN_EMAIL=your-email@example.com

# Path to your automation script directory
AUTOMATION_SCRIPT_PATH=../src/utilities/selenium-inventory-submit

# Absolute path on HOST machine (for Docker-in-Docker via /var/run/docker.sock)
# This should be the absolute path where the selenium script exists on the host
# Required when using Docker-in-Docker for volume mounts
AUTOMATION_SCRIPT_HOST_PATH=/path/to/pubcounter/src/utilities/selenium-inventory-submit

# Discord Webhook (for n8n integration)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/discord-notification

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_PER_USER_PER_HOUR=5

# Application Settings
APP_NAME=Inventory Submission Portal
DOMAIN=yourdomain.com
